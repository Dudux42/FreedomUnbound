# Nothing derived from the game belongs in this repository.
# See GROUND_RULES.md. PortableKit's own ignores (docs/PROFILE_GUIDE.md
# and its .gitignore) are repeated here for the port.

# Disc images
*.iso
*.cso
*.PBP
*.pbp

# Executables, encrypted or decrypted
EBOOT.BIN
EBOOT.ELF
BOOT.BIN
*.ELF
*.elf
*.prx
*.ovl
overlay_*.bin
DATA.BIN
PARAM.SFO

# Derived trees and the player's files
/generated/
/overlays/
/analysis/
/game/
/progress/
/captures/
/dump/
PSP_DATA/
SAVEDATA/
ms0/

# Saves
*.sav

# Build directories and compiler caches
/out/
/out-render/
/out-release/
/build/
/baselines/
cmake-build-*/
CMakeUserPresets.json
b*_perf/
ccache/
.cache/

# Binary build artifacts
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.pdb
*.ilk
*.res
*.tlog

# Scratch
*.generated
*.tmp
*.log
*.bmp
*.wav

# Editor and Python
.vs/
.vscode/
.idea/
*.user
*.suo
.DS_Store
__pycache__/
*.pyc

# Local patch backups
*.patch.bak*
*.patch.new

# Texture dumps: original game textures, never commit
TextureDump/
