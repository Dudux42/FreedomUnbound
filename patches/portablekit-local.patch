diff --git a/tests/vertex_decode_tests.cpp b/tests/vertex_decode_tests.cpp
new file mode 100644
index 0000000..83a7d32
--- /dev/null
+++ b/tests/vertex_decode_tests.cpp
@@ -0,0 +1,187 @@
+// Compare optimized decoding with the general scalar implementation using
+// synthetic guest data. No game files, renderer or display are needed.
+#include "gpu/ge_state.hpp"
+#include "perf/frame_stats.hpp"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <random>
+#include <string_view>
+#include <vector>
+
+namespace { bool reference_decode{}; }
+
+// The decoder's profiling dependencies; tests can select the general loop.
+namespace portablekit::perf {
+bool alternate_off(NewPath path) { return reference_decode && path == NewPath::Decode; }
+bool split_enabled() noexcept { return false; }
+std::uint64_t split_ticks() noexcept { return 0; }
+void add_split(Split, std::uint64_t) noexcept {}
+}
+
+namespace {
+using namespace portablekit::gpu;
+constexpr std::uint32_t kAddress = psprecomp::GuestMemory::kPhysicalBase;
+
+void field(std::uint8_t *at, unsigned type, bool signed_value, std::mt19937 &random) {
+    if (type == 1) { *at = static_cast<std::uint8_t>(random()); }
+    else if (type == 2) { const auto v = static_cast<std::uint16_t>(random()); std::memcpy(at, &v, 2); }
+    else if (type == 3) {
+        const float v = signed_value ? (static_cast<int>(random() % 20001) - 10000) / 16.0f
+                                     : (random() % 1025) / 1024.0f;
+        std::memcpy(at, &v, 4);
+    }
+}
+
+void populate(psprecomp::GuestMemory &memory, unsigned type, unsigned count, std::mt19937 &random) {
+    const VertexFormat layout = vertex_format(type);
+    auto *data = memory.raw_pointer(kAddress, layout.stride * count);
+    std::memset(data, 0, layout.stride * count);
+    const unsigned size[]{0, 1, 2, 4};
+    for (unsigned i = 0; i < count; ++i) {
+        auto *base = data + i * layout.stride;
+        const auto fill = [&](unsigned offset, unsigned format, unsigned components, bool sign) {
+            if (offset == kNoVertexField) return;
+            for (unsigned axis = 0; axis < components; ++axis)
+                field(base + offset + axis * size[format], format, sign, random);
+        };
+        const unsigned weight_type = (type >> 9) & 3, bones = ((type >> 14) & 7) + 1;
+        fill(layout.weight_offset, weight_type, bones, false);
+        // Include zero-weight bones, including runs whose every weight is zero.
+        if (weight_type != 0 && i % 3 == 0)
+            std::memset(base + layout.weight_offset, 0, size[weight_type] * (i % 9 == 0 ? bones : 1));
+        fill(layout.texcoord_offset, type & 3, 2, false);
+        fill(layout.normal_offset, (type >> 5) & 3, 3, true);
+        fill(layout.position_offset, (type >> 7) & 3, 3, true);
+        if (layout.color_offset != kNoVertexField) {
+            const unsigned color = random();
+            std::memcpy(base + layout.color_offset, &color, ((type >> 2) & 7) == 7 ? 4 : 2);
+        }
+    }
+}
+
+bool verify(psprecomp::GuestMemory &memory, unsigned type,
+            const float *matrices, std::mt19937 &random) {
+    constexpr unsigned count = 33;
+    populate(memory, type, count, random);
+    std::vector<Vertex> optimized, reference;
+    reference_decode = false;
+    const unsigned a = decode_vertices(memory, kAddress, type, count, optimized, matrices);
+    reference_decode = true;
+    const unsigned b = decode_vertices(memory, kAddress, type, count, reference, matrices);
+    reference_decode = false;
+    if (a == b && optimized.size() == reference.size() &&
+        std::memcmp(optimized.data(), reference.data(), reference.size() * sizeof(Vertex)) == 0) return true;
+    std::cerr << "Mismatch for vertex type 0x" << std::hex << type << std::dec << '\n';
+    for (unsigned i = 0; i < count; ++i) {
+        if (std::memcmp(&optimized[i], &reference[i], sizeof(Vertex)) != 0) {
+            std::cerr << "vertex " << i << " position " << optimized[i].position[0] << '/' << reference[i].position[0]
+                      << " normal " << optimized[i].normal[0] << '/' << reference[i].normal[0] << '\n';
+            break;
+        }
+    }
+    return false;
+}
+
+// Compare the vertices consumed by complete indexed draws, preserving repeated
+// indices, winding, strips/fans, and IADDR advancement across consecutive PRIMs.
+bool verify_sparse(psprecomp::GuestMemory &memory, unsigned type, unsigned primitive,
+                   const std::array<float, 96> &bones, std::mt19937 &random) {
+    populate(memory, type, 1024u, random);
+    constexpr auto indices_address = kAddress + 0x10000u;
+    constexpr auto list_address = kAddress + 0x20000u;
+    const std::uint16_t indices[]{4, 900, 1023, 900, 4, 1000, 2, 750, 800, 750, 2, 750, 0, 1, 2, 2, 1, 0};
+    std::memcpy(memory.raw_pointer(indices_address, sizeof(indices)), indices, sizeof(indices));
+    std::vector<std::uint32_t> commands{0x10080000u, 0x12000000u | type | (2u << 11u),
+                                      0x01000000u | (kAddress & 0xFFFFFFu),
+                                      0x02000000u | (indices_address & 0xFFFFFFu), 0x2A000000u};
+    for (float bone : bones) {
+        std::uint32_t bits;
+        std::memcpy(&bits, &bone, sizeof(bits));
+        commands.push_back(0x2B000000u | (bits >> 8u));
+    }
+    for (unsigned draw = 0u; draw < 3u; ++draw) commands.push_back(0x04000006u | primitive << 16u);
+    commands.push_back(0x0C000000u);
+    std::memcpy(memory.raw_pointer(list_address, commands.size() * 4u), commands.data(), commands.size() * 4u);
+    std::array<std::vector<Vertex>, 2> consumed;
+    std::array<std::vector<std::size_t>, 2> sizes;
+    for (unsigned route = 0u; route < 2u; ++route) {
+        reference_decode = route != 0u;
+        GeState ge;
+        ge.set_draw_sink([&](const DrawCall &call) {
+            sizes[route].push_back(call.vertices.size());
+            for (auto index : call.indices) consumed[route].push_back(call.vertices.at(index));
+        });
+        bool finished = false;
+        ge.execute(memory, list_address, 0u, finished);
+        if (!finished || sizes[route].size() != 3u) return false;
+    }
+    reference_decode = false;
+    return sizes[0] == std::vector<std::size_t>{4u, 3u, 3u} &&
+           sizes[1] == std::vector<std::size_t>{1020u, 799u, 3u} &&
+           consumed[0].size() == 18u && consumed[1].size() == 18u &&
+           std::memcmp(consumed[0].data(), consumed[1].data(), 18u * sizeof(Vertex)) == 0;
+}
+}
+
+int main(int argc, char **argv) {
+    psprecomp::GuestMemory memory;
+    std::mt19937 random(0x4d484655);
+    std::array<float, 96> bones;
+    for (float &v : bones) v = (static_cast<int>(random() % 20001) - 10000) / 128.0f;
+    unsigned cases = 0;
+    for (unsigned w = 0; w < 4; ++w)
+        for (unsigned n = 0; n < 4; ++n)
+            for (unsigned p = 1; p < 4; ++p)
+                for (unsigned uv = 0; uv < 4; ++uv)
+                    for (unsigned c : {0u, 4u, 5u, 6u, 7u})
+                        for (unsigned count = 1; count <= 8; ++count) {
+                            const unsigned type = uv | c << 2 | n << 5 | p << 7 | w << 9 | (count - 1) << 14;
+                            if (!verify(memory, type, bones.data(), random) ||
+                                !verify(memory, type | (1u << 23), bones.data(), random) ||
+                                !verify(memory, type, nullptr, random)) return 1;
+                            cases += 3;
+                        }
+    std::cout << cases << " decode cases match the general loop bit for bit\n";
+    unsigned sparse_cases = 0u;
+    for (unsigned w = 0u; w < 4u; ++w)
+        for (unsigned n = 0u; n < 4u; ++n)
+            for (unsigned p = 1u; p < 4u; ++p)
+                for (unsigned uv = 0u; uv < 4u; ++uv)
+                    for (unsigned c : {0u, 4u, 5u, 6u, 7u})
+                        for (unsigned count : {1u, 8u})
+                            for (unsigned primitive = 0u; primitive < 6u; ++primitive) {
+                                const unsigned type = uv | c << 2u | n << 5u | p << 7u | w << 9u | (count - 1u) << 14u;
+                                if (!verify_sparse(memory, type, primitive, bones, random) ||
+                                    !verify_sparse(memory, type | (1u << 23u), primitive, bones, random)) {
+                                    std::cerr << "Sparse draw mismatch: type=" << type << " primitive=" << primitive << '\n';
+                                    return 1;
+                                }
+                                sparse_cases += 2u;
+                            }
+    std::cout << sparse_cases << " sparse indexed draw cases match the reference vertex stream bit for bit\n";
+    if (argc > 1 && std::string_view(argv[1]) == "--benchmark") {
+        std::vector<Vertex> vertices;
+        for (unsigned weights : {1u, 2u, 3u}) {
+          for (unsigned count : {8u, 32u, 256u, 4096u}) {
+            const unsigned repetitions = 819200u / count;
+            const unsigned type = 2u | 7u << 2 | 2u << 5 | 2u << 7 | weights << 9 | 7u << 14;
+            populate(memory, type, count, random);
+            std::array<double, 5> times;
+            for (double &time : times) {
+                const auto start = std::chrono::steady_clock::now();
+                for (unsigned i = 0; i < repetitions; ++i)
+                    decode_vertices(memory, kAddress, type, count, vertices, bones.data());
+                time = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+            }
+            std::sort(times.begin(), times.end());
+            std::cout << "weight format " << weights << ", batch " << count << ": median " << times[2] << " ms for "
+                      << count * repetitions << " vertices; checksum " << vertices[count - 2].position[0] << '\n';
+          }
+        }
+    }
+    return 0;
+}
