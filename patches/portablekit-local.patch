+// FU Controls: one file:// URL helper for the save screen, the menu and the
+// font menu (save_screen.hpp). Backslashes become '/', a drive path gets the
+// third slash (file:///C:/Users/...), a UNC path //server/share becomes
+// file://server/share. ':' and '/' stay; spaces, '%', '#', '?' and other ASCII
+// specials are percent-encoded. UTF-8 bytes (accents) are kept as they are:
+// SDL_OpenURL hands the string to ShellExecuteW as UTF-16, and Explorer opens
+// such IRIs, while it does not always decode %C3%A9.
+std::string file_url(const std::string &path) {
+    std::string p = path;
+    for (char &c : p)
+        if (c == '\\') c = '/';
+    std::string url;
+    if (p.size() >= 2 && std::isalpha(static_cast<unsigned char>(p[0])) != 0 && p[1] == ':') url = "file:///";
+    else if (p.rfind("//", 0) == 0) {
+        url = "file:";
+    } else {
+        url = "file://";
+        if (p.empty() || p[0] != '/') url += '/';
+    }
+    for (const unsigned char c : p) {
+        if (c >= 0x80 || std::isalnum(c) != 0 || c == '/' || c == ':' || c == '-' || c == '_' || c == '.' ||
+            c == '~') {
+            url += static_cast<char>(c);
+        } else {
+            char escaped[4];
+            std::snprintf(escaped, sizeof(escaped), "%%%02X", c);
+            url += escaped;
+        }
+    }
+    return url;
+}
+
 } // namespace portablekit::ui
