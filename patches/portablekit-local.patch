+    Dialog &d = dialog();
+    d = Dialog{};
+    d.open = true;
+    d.kind = kind;
+    d.request = std::move(request);
+    d.on_done = std::move(on_done);
+    d.arm_focus = true;
+    if (d.request.initial < 0 || d.request.initial >= static_cast<int>(d.request.choices.size())) d.request.initial = 0;
+    return true;
+}
+
+void dismiss_system_dialog() {
+    Dialog &d = dialog();
