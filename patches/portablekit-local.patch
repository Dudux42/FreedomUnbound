+#pragma once
+
+// Host strings: every player-visible English string the port itself shows
+// (save and message dialogs, the launcher's save summary). Each has a stable
+// id such as "save.confirm.overwrite" and a built-in English default.
+//
+// A port can point the table at override files (a text mod's text/host.txt).
+// Files are UTF-8, one `id=text` per line, `#` starts a comment line, `\n` in
+// the text is a line break and `\\` a backslash. Files apply in order, later
+// ones winning. An unknown id is ignored with a log line; a missing id keeps
+// its English default. Placeholders {0}, {1}... are filled by format().
+// A value wrapped in double quotes (\"  /  \") is taken verbatim without the quotes,
+// so leading or trailing spaces survive editors that strip them.
+#include <filesystem>
+#include <functional>
+#include <initializer_list>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace portablekit::ui::host_text {
+
+// The text after '=' on a host.txt line, before \n and \\ are decoded: kept as
+// written, except that a value whose trimmed form is wrapped in double quotes
+// is the text between the quotes, verbatim (", " keeps its trailing space).
+[[nodiscard]] inline std::string_view value_text(std::string_view raw) {
+    std::string_view s = raw;
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t')) s.remove_prefix(1);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\t' || s.back() == '\r')) s.remove_suffix(1);
+    if (s.size() >= 2 && s.front() == '"' && s.back() == '"') return s.substr(1, s.size() - 2);
+    return raw;
+}
+// The text for an id. An id with no built-in default comes back as itself.
+[[nodiscard]] std::string get(std::string_view id);
+// get(id) with {0}, {1}... replaced by args in order.
+[[nodiscard]] std::string format(std::string_view id, std::initializer_list<std::string> args);
+// get(id) as a C string that stays valid for the rest of the run, for ImGui
+// labels and other `const char *` uses. Each distinct text is kept once.
+[[nodiscard]] const char *cstr(std::string_view id);
+
+// The language setting (settings.ini ui.language): "auto", "en" or "pt-BR".
+// Setting it re-reads the override files, since the provider picks them by
+// language. Before the first call it is "auto".
+void set_language(std::string_view setting);
+[[nodiscard]] std::string language_setting();
+// The system's display language as "pt-BR" (any pt-*) or "en" (anything
+// else): GetUserDefaultUILanguage on Windows, LC_ALL/LC_MESSAGES/LANG elsewhere.
+[[nodiscard]] std::string system_language();
+// The language the override files were last chosen for ("en", "pt-BR"...),
+// as the provider resolved it (Auto included); the provider reports it with
+// set_effective_language. Before that: the setting, or on Auto the system's.
+void set_effective_language(std::string_view language);
+[[nodiscard]] std::string effective_language();
+
+// Returns the override files to apply, first to last. Called at most about
+// once a second from get(); the table reloads only when the list or a file's
+// modification time changed, so switching a mod on or off is picked up.
+using Provider = std::function<std::vector<std::filesystem::path>()>;
+void set_provider(Provider provider);
+// Re-reads the override files now.
+void reload();
+
+// The built-in table, for tooling and tests.
+struct Entry {
+    const char *id;
+    const char *english;
+};
+[[nodiscard]] const std::vector<Entry> &defaults();
+
+} // namespace portablekit::ui::host_text
