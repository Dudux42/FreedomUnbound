+namespace portablekit::ui {
+namespace {
+
+enum class Phase { Main, Confirm };
+
+struct Dialog {
+    bool open{};
+    DialogKind kind{DialogKind::Notice};
+    Phase phase{Phase::Main};
+    DialogRequest request;
+    DialogDone on_done;
+    bool arm_focus{true};
+    std::string pending_id;
+    std::string pending_label;
+};
+
+Dialog &dialog() {
+    static Dialog value;
+    return value;
+}
+
+void restore_game() {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return;
+    layer.set_interactive(false);
+    layer.renderer().set_game_input(true);
+    layer.renderer().hold_frame(false);
+}
+
+void finish(std::optional<std::string> answer) {
+    Dialog &d = dialog();
+    if (!d.open) return;
+    d.open = false;
+    restore_game();
+    DialogDone done = std::move(d.on_done);
+    d.on_done = nullptr;
+    if (done) done(std::move(answer));
+}
+
+bool pad_cancel() {
+    const ImGuiKey cancel = Layer::get().confirm_south() ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+    return ImGui::IsKeyPressed(cancel, false);
+}
+
+std::string subtitle_of(const Dialog &d) {
+    if (d.phase == Phase::Confirm) return host_text::get("dialog.subtitle.confirm");
+    if (d.kind == DialogKind::YesNo)
+        return host_text::get(d.request.default_no ? "dialog.subtitle.default_no" : "dialog.subtitle.yes_no");
+    if (d.kind == DialogKind::Notice) return {};
+    if (d.request.choices.empty()) return host_text::get("dialog.subtitle.no_data");
+    const auto count = d.request.choices.size();
+    return host_text::format(count == 1u ? "dialog.subtitle.save_count_one" : "dialog.subtitle.save_count",
+                             {std::to_string(count)});
+}
+
+std::string footer_text(const Dialog &d) {
+    if (d.phase == Phase::Confirm) return host_text::get("dialog.footer.confirm");
+    if (d.kind == DialogKind::Notice) return host_text::get("dialog.footer.notice");
+    if (d.kind == DialogKind::YesNo) return host_text::get("dialog.footer.yes_no");
+    if (d.request.choices.empty()) return host_text::get("dialog.footer.empty");
+    if (d.kind == DialogKind::LoadList) return host_text::get("dialog.footer.load");
+    if (d.kind == DialogKind::DeleteList) return host_text::get("dialog.footer.delete");
+    return host_text::get("dialog.footer.save");
+}
+
+// A button label with a fixed ImGui id, so translations don't change focus ids.
+std::string button(const char *id, const char *imgui_id) { return host_text::get(id) + imgui_id; }
+
+} // namespace
+
+bool system_dialog_open() { return dialog().open; }
+
+bool open_system_dialog(DialogKind kind, DialogRequest request, DialogDone on_done) {
+    Layer &layer = Layer::get();
+    if (!layer.attached()) return false;
+    if (dialog().open) dismiss_system_dialog();
+    layer.renderer().hold_frame(true);
+    layer.renderer().set_game_input(false);
+    layer.set_interactive(true);
