+#include "save_data/auto_backup.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <system_error>
+
+namespace portablekit::savedata::auto_backup {
+namespace {
+
+namespace fs = std::filesystem;
+
+constexpr const char *kPartial = ".partial";
+
+std::string describe(const fs::path &path, const std::error_code &ec) {
+    const std::u8string u8 = path.u8string();
+    return std::string(reinterpret_cast<const char *>(u8.c_str()), u8.size()) + ": " + ec.message();
+}
+
+// Regular files under `folder`, by path relative to it.
+bool files_in(const fs::path &folder, std::map<fs::path, fs::path> &out) {
+    std::error_code ec;
+    fs::recursive_directory_iterator it(folder, ec), end;
+    if (ec) return false;
+    for (; it != end; it.increment(ec)) {
+        if (ec) return false;
+        std::error_code type_ec;
+        if (it->is_regular_file(type_ec)) out.emplace(it->path().lexically_relative(folder), it->path());
+    }
+    return true;
+}
+
+bool same_file(const fs::path &a, const fs::path &b) {
+    std::error_code ec;
+    const auto size_a = fs::file_size(a, ec);
+    if (ec) return false;
+    const auto size_b = fs::file_size(b, ec);
+    if (ec || size_a != size_b) return false;
+    std::ifstream in_a(a, std::ios::binary), in_b(b, std::ios::binary);
+    if (!in_a || !in_b) return false;
+    char buf_a[64 * 1024], buf_b[64 * 1024];
+    while (in_a && in_b) {
+        in_a.read(buf_a, sizeof(buf_a));
+        in_b.read(buf_b, sizeof(buf_b));
+        if (in_a.gcount() != in_b.gcount()) return false;
+        if (!std::equal(buf_a, buf_a + in_a.gcount(), buf_b)) return false;
+    }
+    return in_a.eof() && in_b.eof();
+}
+
+// Copies a folder tree, keeping each file's modification time (the summary's
+// stamp is the save file's time).
+bool copy_tree(const fs::path &from, const fs::path &to, std::string &error) {
+    std::error_code ec;
+    fs::create_directories(to, ec);
+    if (ec) { error = describe(to, ec); return false; }
+    std::map<fs::path, fs::path> files;
+    if (!files_in(from, files)) { error = describe(from, std::make_error_code(std::errc::io_error)); return false; }
+    // Empty subfolders too.
+    for (fs::recursive_directory_iterator it(from, ec), end; !ec && it != end; it.increment(ec)) {
+        std::error_code type_ec;
+        if (it->is_directory(type_ec)) fs::create_directories(to / it->path().lexically_relative(from), type_ec);
+    }
+    for (const auto &[relative, source] : files) {
+        const fs::path target = to / relative;
+        fs::create_directories(target.parent_path(), ec);
+        if (!fs::copy_file(source, target, fs::copy_options::overwrite_existing, ec)) {
+            error = describe(target, ec);
+            return false;
+        }
+        const auto stamp = fs::last_write_time(source, ec);
+        if (!ec) fs::last_write_time(target, stamp, ec);
+    }
+    return true;
+}
+
+bool copy_one(const fs::path &from, const fs::path &to, std::string &error) {
+    std::error_code ec;
+    fs::create_directories(to.parent_path(), ec);
+    if (!fs::copy_file(from, to, fs::copy_options::overwrite_existing, ec)) {
+        error = describe(to, ec);
+        return false;
+    }
+    const auto stamp = fs::last_write_time(from, ec);
+    if (!ec) fs::last_write_time(to, stamp, ec);
+    return true;
+}
+
+bool is_dir(const fs::path &p) {
+    std::error_code ec;
+    return fs::is_directory(p, ec);
+}
+
+bool is_file(const fs::path &p) {
+    std::error_code ec;
+    return fs::is_regular_file(p, ec);
+}
+
+std::string name_of(const fs::path &p) {
+    const auto u8 = p.filename().u8string();
+    return std::string(reinterpret_cast<const char *>(u8.c_str()), u8.size());
+}
+
+// Leftovers of a backup or restore that was cut short.
+void clean_partials(const Config &config) {
+    std::error_code ec;
+    for (fs::directory_iterator it(config.root, ec), end; !ec && it != end; it.increment(ec)) {
+        const std::string name = name_of(it->path());
+        if (name.size() > 8 && name.ends_with(kPartial) && is_stamp_name(name.substr(0, name.size() - 8))) {
+            std::error_code rm_ec;
+            fs::remove_all(it->path(), rm_ec);
+        }
+    }
+}
+
+std::tm local_tm(std::time_t t) {
+    std::tm tm{};
+#if defined(_WIN32)
+    localtime_s(&tm, &t);
+#else
+    localtime_r(&t, &tm);
+#endif
+    return tm;
+}
+
+} // namespace
+
+Config make_config(const fs::path &memory_stick, const std::string &save_name, const std::string &summary_relative,
+                   std::size_t keep) {
+    fs::path stick = memory_stick.lexically_normal();
+    if (!stick.has_filename()) stick = stick.parent_path();
+    const fs::path data = stick.parent_path();
+    Config config;
+    config.save_folder = stick / "PSP" / "SAVEDATA" / save_name;
+    if (!summary_relative.empty()) config.summary_file = data / fs::path(summary_relative);
+    config.root = data / "SaveBackups";
+    config.keep = keep;
+    return config;
+}
+
+fs::path Entry::save(const Config &config) const { return folder / config.save_folder.filename(); }
+
+fs::path Entry::summary(const Config &config) const {
+    if (config.summary_file.empty()) return {};
+    return folder / config.summary_file.filename();
+}
+
+std::string stamp_name(std::chrono::system_clock::time_point time) {
+    const std::tm tm = local_tm(std::chrono::system_clock::to_time_t(time));
+    char text[32];
+    std::strftime(text, sizeof(text), "%Y%m%d-%H%M%S", &tm);
+    return text;
+}
+
+bool is_stamp_name(const std::string &name) {
+    if (name.size() != 15 || name[8] != '-') return false;
+    for (std::size_t i = 0; i < name.size(); ++i)
+        if (i != 8 && std::isdigit(static_cast<unsigned char>(name[i])) == 0) return false;
+    return true;
+}
+
+std::string stamp_for_display(const std::string &stamp) {
+    if (!is_stamp_name(stamp)) return stamp;
+    return stamp.substr(0, 4) + "-" + stamp.substr(4, 2) + "-" + stamp.substr(6, 2) + " " + stamp.substr(9, 2) + ":" +
+           stamp.substr(11, 2) + ":" + stamp.substr(13, 2);
+}
+
+std::vector<Entry> list(const Config &config) {
+    std::vector<Entry> out;
+    std::error_code ec;
+    for (fs::directory_iterator it(config.root, ec), end; !ec && it != end; it.increment(ec)) {
+        const std::string name = name_of(it->path());
+        if (!is_stamp_name(name) || !is_dir(it->path())) continue;
+        out.push_back({it->path(), name});
+    }
+    std::sort(out.begin(), out.end(), [](const Entry &a, const Entry &b) { return a.stamp > b.stamp; });
+    return out;
+}
+
+bool same_contents(const fs::path &a, const fs::path &b) {
+    std::map<fs::path, fs::path> files_a, files_b;
+    if (!files_in(a, files_a) || !files_in(b, files_b)) return false;
+    if (files_a.size() != files_b.size()) return false;
+    for (const auto &[relative, path] : files_a) {
+        const auto other = files_b.find(relative);
+        if (other == files_b.end() || !same_file(path, other->second)) return false;
+    }
+    return true;
+}
+
+bool changed_since_last_backup(const Config &config) {
+    if (!is_dir(config.save_folder)) return false;
+    const std::vector<Entry> backups = list(config);
+    if (backups.empty()) return true;
+    return !same_contents(config.save_folder, backups.front().save(config));
+}
+
+std::vector<fs::path> rotate(const Config &config, const fs::path &protect) {
+    std::vector<fs::path> removed;
+    const std::vector<Entry> backups = list(config);
+    std::size_t kept = 0;
+    for (const Entry &entry : backups) {
+        std::error_code ec;
+        const bool protected_entry = !protect.empty() && fs::equivalent(entry.folder, protect, ec);
+        if (protected_entry || kept < config.keep) {
+            if (!protected_entry) ++kept;
+            continue;
+        }
+        fs::remove_all(entry.folder, ec);
+        if (!ec) removed.push_back(entry.folder);
+    }
+    return removed;
+}
+
+Result back_up(const Config &config, std::chrono::system_clock::time_point now, const fs::path &protect) {
+    Result result;
+    if (!is_dir(config.save_folder)) {
+        result.ok = true;
+        result.skipped = true;
+        return result;
+    }
+    std::error_code ec;
+    fs::create_directories(config.root, ec);
+    if (ec) { result.error = describe(config.root, ec); return result; }
+    clean_partials(config);
+    // One backup per second at most: a taken name moves on a second.
+    std::string stamp = stamp_name(now);
+    for (int i = 1; fs::exists(config.root / stamp, ec) && i < 600; ++i)
+        stamp = stamp_name(now + std::chrono::seconds(i));
+    const fs::path final_folder = config.root / stamp;
+    const fs::path partial = config.root / (stamp + kPartial);
+    fs::remove_all(partial, ec);
+    if (!copy_tree(config.save_folder, partial / config.save_folder.filename(), result.error)) {
+        fs::remove_all(partial, ec);
+        return result;
+    }
+    if (!config.summary_file.empty() && is_file(config.summary_file) &&
+        !copy_one(config.summary_file, partial / config.summary_file.filename(), result.error)) {
+        fs::remove_all(partial, ec);
+        return result;
+    }
+    fs::rename(partial, final_folder, ec);
+    if (ec) {
+        result.error = describe(final_folder, ec);
+        fs::remove_all(partial, ec);
+        return result;
+    }
+    result.ok = true;
+    result.folder = final_folder;
+    result.removed = rotate(config, protect);
+    return result;
+}
+
+Result back_up_if_changed(const Config &config, std::chrono::system_clock::time_point now) {
+    if (!changed_since_last_backup(config)) {
+        Result result;
+        result.ok = true;
+        result.skipped = true;
+        return result;
+    }
+    return back_up(config, now);
+}
+
+Result restore(const Config &config, const Entry &chosen, std::chrono::system_clock::time_point now) {
+    Result result;
+    const fs::path source = chosen.save(config);
+    if (!is_dir(source)) {
+        result.error = describe(source, std::make_error_code(std::errc::no_such_file_or_directory));
+        return result;
+    }
+    // Copy the chosen backup aside first: backing up the current save below may
+    // rotate old backups out (the chosen one is protected as well).
+    if (changed_since_last_backup(config)) {
+        const Result before = back_up(config, now, chosen.folder);
+        if (!before.ok) {
+            result.error = before.error;
+            return result;
+        }
+        result.removed = before.removed;
+    }
+    std::error_code ec;
+    const fs::path staging = fs::path(config.save_folder.native() + fs::path(".restoring").native());
+    const fs::path replaced = fs::path(config.save_folder.native() + fs::path(".replaced").native());
+    fs::remove_all(staging, ec);
+    fs::remove_all(replaced, ec);
+    if (!copy_tree(source, staging, result.error)) {
+        fs::remove_all(staging, ec);
+        return result;
+    }
+    const bool had_save = is_dir(config.save_folder);
+    if (had_save) {
+        fs::rename(config.save_folder, replaced, ec);
+        if (ec) {
+            result.error = describe(config.save_folder, ec);
+            fs::remove_all(staging, ec);
+            return result;
+        }
+    }
+    fs::rename(staging, config.save_folder, ec);
+    if (ec) {
+        result.error = describe(config.save_folder, ec);
+        std::error_code back_ec;
+        if (had_save) fs::rename(replaced, config.save_folder, back_ec);
+        fs::remove_all(staging, back_ec);
+        return result;
+    }
+    fs::remove_all(replaced, ec);
+    // The summary goes with the save; with none in the backup the old one is
+    // removed, so the launcher shows the preview as pending, not wrong.
+    if (!config.summary_file.empty()) {
+        const fs::path summary = chosen.summary(config);
+        std::string summary_error;
+        if (is_file(summary)) copy_one(summary, config.summary_file, summary_error);
+        else fs::remove(config.summary_file, ec);
+    }
+    result.ok = true;
+    result.folder = chosen.folder;
+    return result;
+}
+
+} // namespace portablekit::savedata::auto_backup
diff --git a/host/save_data/auto_backup.hpp b/host/save_data/auto_backup.hpp
new file mode 100644
index 0000000..92b8b30
--- /dev/null
+++ b/host/save_data/auto_backup.hpp
@@ -0,0 +1,86 @@
+#pragma once
+
+// Automatic save backups (FU Saves). Before the game starts, the game's main
+// save folder is copied to <data>/SaveBackups/<yyyyMMdd-HHmmss>/ when it
+// changed since the newest backup there, with the port's save summary file
+// beside it, and only the newest `keep` backups are kept. Restore puts one of
+// them back, after backing up the save it replaces.
+//
+// Layout of one backup:
+//   <root>/20261014-001705/ULUS10391/...      the save folder, as it was
+//   <root>/20261014-001705/ULUS10391.txt      the summary, when there was one
+//
+// Only folders named exactly yyyyMMdd-HHmmss are listed, rotated or deleted;
+// anything else in the root is left alone. A backup is written to a
+// "<stamp>.partial" folder first and renamed when complete.
+//
+// Plain std::filesystem, no profile or UI, so it builds on its own for tests
+// (tests/auto_backup_tests.cpp). It never reads the save's contents except to
+// compare them byte for byte, and never logs or returns them.
+#include <chrono>
+#include <cstddef>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace portablekit::savedata::auto_backup {
+
+struct Config {
+    std::filesystem::path save_folder;   // <ms0>/PSP/SAVEDATA/ULUS10391
+    std::filesystem::path summary_file;  // <data>/save-preview/ULUS10391.txt; empty: none
+    std::filesystem::path root;          // <data>/SaveBackups
+    std::size_t keep = 5;
+};
+
+// The usual config: <data> is the folder that holds the memory stick.
+// summary_relative is relative to <data> (may be empty).
+[[nodiscard]] Config make_config(const std::filesystem::path &memory_stick, const std::string &save_name,
+                                 const std::string &summary_relative, std::size_t keep);
+
+struct Entry {
+    std::filesystem::path folder;  // <root>/<stamp>
+    std::string stamp;             // yyyyMMdd-HHmmss
+    [[nodiscard]] std::filesystem::path save(const Config &config) const;
+    [[nodiscard]] std::filesystem::path summary(const Config &config) const;
+};
+
+struct Result {
+    bool ok{};
+    bool skipped{};                 // nothing to do: no save, or unchanged
+    std::filesystem::path folder;   // the backup made (or restored from)
+    std::vector<std::filesystem::path> removed;  // rotated out
+    std::string error;
+};
+
+// yyyyMMdd-HHmmss in local time.
+[[nodiscard]] std::string stamp_name(std::chrono::system_clock::time_point time);
+[[nodiscard]] bool is_stamp_name(const std::string &name);
+// "2026-10-14 00:17:05" for "20261014-001705"; the input itself if malformed.
+[[nodiscard]] std::string stamp_for_display(const std::string &stamp);
+
+// Backups in the root, newest first.
+[[nodiscard]] std::vector<Entry> list(const Config &config);
+
+// True when both folders hold the same files with the same bytes.
+[[nodiscard]] bool same_contents(const std::filesystem::path &a, const std::filesystem::path &b);
+
+// Whether the save differs from the newest backup (true when there is none).
+// False when there is no save.
+[[nodiscard]] bool changed_since_last_backup(const Config &config);
+
+// Deletes backups beyond the newest `keep`, never `protect`. Returns what went.
+std::vector<std::filesystem::path> rotate(const Config &config, const std::filesystem::path &protect = {});
+
+// A backup now, whether or not the save changed. Skipped when there is no save.
+Result back_up(const Config &config, std::chrono::system_clock::time_point now,
+               const std::filesystem::path &protect = {});
+// The pre-game backup: back_up() only when changed_since_last_backup().
+Result back_up_if_changed(const Config &config, std::chrono::system_clock::time_point now);
+
+// Puts `chosen` back as the save: first backs up the current save if it is not
+// already the newest backup, then replaces the save folder (through a staging
+// copy, so a failure leaves the current save in place) and the summary file.
+// File times are kept, so the summary still matches the restored save.
+Result restore(const Config &config, const Entry &chosen, std::chrono::system_clock::time_point now);
+
+} // namespace portablekit::savedata::auto_backup
