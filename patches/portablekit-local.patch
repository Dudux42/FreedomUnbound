+// Seconds the toast has left; picks up a newly saved screenshot first.
+double toast_seconds_left() {
+    Toast &t = toast_state();
+    if (const auto name = gpu::take_saved_screenshot()) {
+        t.text = host_text::format("launcher.overlay.screenshot_saved", {*name});
+        t.shown = std::chrono::steady_clock::now();
+    }
+    if (t.text.empty()) return 0.0;
+    const double age = std::chrono::duration<double>(std::chrono::steady_clock::now() - t.shown).count();
+    return kToastSeconds - age;
+}
