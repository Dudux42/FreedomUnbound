diff --git a/host/ui/launcher_home.cpp b/host/ui/launcher_home.cpp
new file mode 100644
index 0000000..4844a01
--- /dev/null
+++ b/host/ui/launcher_home.cpp
@@ -0,0 +1,563 @@
+// The launcher's home screen (GameProfile::launcher_home): what the program
+// opens on once the game data is set up, before the game boots. Play boots
+// the game; Settings, Saves and Game data open what the port already has (the
+// menu's settings pages, the save screen and the setup), so nothing here is
+// new machinery. Port-owned scenery can accompany the modern navigation.
+
+#include "ui/ui.hpp"
+
+#include "ui/layer.hpp"
+#include "ui/save_screen.hpp"
+#include "ui/widgets.hpp"
+
+#include "hle/hle_common.hpp"
+#include "profile.hpp"
+#include "install/installer.hpp"
+#include "install/user_data.hpp"
+#include "save_data/auto_backup.hpp"
+#include "save_data/save_transfer.hpp"
+#include "ui/host_text.hpp"
+#include "settings/settings.hpp"
+#include "gpu/screenshots.hpp"
+
+#include "imgui.h"
+
+#include <algorithm>
+#include <chrono>
+#include <iostream>
+#include <cmath>
+#include <filesystem>
+#include <initializer_list>
+#include <string>
+#include <vector>
+
+namespace portablekit::ui {
+namespace {
+
+namespace fs = std::filesystem;
+
+// The home screen's buttons, top to bottom.
+enum class Action { None, Play, Settings, Mods, Cheats, Saves, GameData, Screenshots, WhatsNew, Report, Quit };
+
+float font() { return Layer::get().font_size(); }
+float px(float value) { return std::round(value * Layer::get().scale()); }
+
+std::string path_text(const fs::path &path) {
+    return path.empty() ? std::string(host_text::cstr("launcher.home.none")) : install::path_to_utf8(path);
+}
+
+std::string disc_text(const install::HomeInfo &info) {
+    if (info.disc_image.empty()) return host_text::cstr("launcher.home.none_the_game_cannot_read");
+    return path_text(info.disc_image) + "   " + (info.image_copied ? host_text::cstr("launcher.home.the_copy_in_the_data") : host_text::cstr("launcher.home.used_where_it_is"));
+}
+
+std::string saves_text(const install::HomeInfo &info) {
+    return info.memory_stick.empty() ? std::string(host_text::cstr("launcher.home.none")) : path_text(info.memory_stick / "PSP" / "SAVEDATA");
+}
+
+// The pad's back button: the face button that does not confirm.
+bool pad_back_pressed() {
+    const ImGuiKey cancel = Layer::get().confirm_south() ? ImGuiKey_GamepadFaceRight : ImGuiKey_GamepadFaceDown;
+    return ImGui::IsKeyPressed(cancel, false);
+}
+
+// A dim label over its value, wrapped. Not focusable, so only the buttons
+// take the focus.
+void detail(const char *label, const std::string &value) {
+    ImGui::PushFont(nullptr, ImGui::GetStyle().FontSizeBase * 0.8f);
+    paragraph(label, colors::kTextDim);
+    ImGui::PopFont();
+    paragraph(value);
+    ImGui::Dummy({0.0f, px(6.0f)});
+}
+
+void details(const install::HomeInfo &info) {
+    detail(host_text::cstr("launcher.home.data_folder"), path_text(info.game_dir));
+    detail(host_text::cstr("launcher.home.disc_image"), disc_text(info));
+    detail(host_text::cstr("launcher.home.saves_folder"), saves_text(info));
+}
+
+// Pressed this frame, with repeat: any of `keys`.
+bool pressed(std::initializer_list<ImGuiKey> keys) {
+    for (ImGuiKey key : keys)
+        if (ImGui::IsKeyPressed(key, true)) return true;
+    return false;
+}
+
+// FU Controls: left or right on the keyboard, the D-pad or the left stick.
+bool left_pressed() { return pressed({ImGuiKey_LeftArrow, ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadLStickLeft}); }
+bool right_pressed() { return pressed({ImGuiKey_RightArrow, ImGuiKey_GamepadDpadRight, ImGuiKey_GamepadLStickRight}); }
+// FU Controls: up or down, likewise (the language flags' explicit navigation).
+bool up_pressed() { return pressed({ImGuiKey_UpArrow, ImGuiKey_GamepadDpadUp, ImGuiKey_GamepadLStickUp}); }
+bool down_pressed() { return pressed({ImGuiKey_DownArrow, ImGuiKey_GamepadDpadDown, ImGuiKey_GamepadLStickDown}); }
+
+// FU Controls: the language flags under the update button, drawn in code (no
+// image assets): a simplified Union Jack and the Brazilian flag.
+void draw_flag(ImDrawList *d, ImVec2 a, ImVec2 b, bool brazil) {
+    const float w = b.x - a.x, h = b.y - a.y;
+    const ImVec2 c{a.x + w * 0.5f, a.y + h * 0.5f};
+    d->PushClipRect(a, b, true);
+    if (brazil) {
+        d->AddRectFilled(a, b, IM_COL32(0, 151, 57, 255));
+        d->AddQuadFilled({c.x, a.y + h * 0.1f}, {b.x - w * 0.08f, c.y}, {c.x, b.y - h * 0.1f}, {a.x + w * 0.08f, c.y},
+                         IM_COL32(254, 221, 0, 255));
+        d->AddCircleFilled(c, h * 0.24f, IM_COL32(0, 39, 118, 255));
+    } else {
+        const ImU32 white = IM_COL32(255, 255, 255, 255), red = IM_COL32(200, 16, 46, 255);
+        d->AddRectFilled(a, b, IM_COL32(1, 33, 105, 255));
+        d->AddLine(a, b, white, h * 0.2f);
+        d->AddLine({a.x, b.y}, {b.x, a.y}, white, h * 0.2f);
+        d->AddLine(a, b, red, h * 0.07f);
+        d->AddLine({a.x, b.y}, {b.x, a.y}, red, h * 0.07f);
+        d->AddRectFilled({c.x - h * 0.17f, a.y}, {c.x + h * 0.17f, b.y}, white);
+        d->AddRectFilled({a.x, c.y - h * 0.17f}, {b.x, c.y + h * 0.17f}, white);
+        d->AddRectFilled({c.x - h * 0.1f, a.y}, {c.x + h * 0.1f, b.y}, red);
+        d->AddRectFilled({a.x, c.y - h * 0.1f}, {b.x, c.y + h * 0.1f}, red);
+    }
+    d->PopClipRect();
+}
+
+// A 32x22 flag button: navigable (keyboard, pad), tooltip and footer text on
+// hover or focus, the active language outlined and the other dimmed.
+// EnableNav: InvisibleButton is NoNav without it, so the keyboard and pad
+// could never focus or activate a flag. `focus` focuses it this frame
+// (widgets' focus_next_row is only taken by its own rows, not this button).
+bool flag_button(const char *id, bool brazil, bool active, const char *tip, bool focus) {
+    const bool pressed = ImGui::InvisibleButton(id, {px(32.0f), px(22.0f)}, ImGuiButtonFlags_EnableNav);
+    if (focus) ImGui::SetKeyboardFocusHere(-1);
+    const ImVec2 a = ImGui::GetItemRectMin(), b = ImGui::GetItemRectMax();
+    const bool hot = ImGui::IsItemHovered() || ImGui::IsItemFocused();
+    ImDrawList *d = ImGui::GetWindowDrawList();
+    draw_flag(d, a, b, brazil);
+    if (!active && !hot) d->AddRectFilled(a, b, IM_COL32(0, 0, 0, 110));
+    d->AddRect({a.x - px(2.0f), a.y - px(2.0f)}, {b.x + px(2.0f), b.y + px(2.0f)},
+               active ? colors::kAccentBright : hot ? colors::kText : colors::kPanelEdge, px(3.0f), 0,
+               active ? px(2.5f) : px(1.0f));
+    if (hot) {
+        ImGui::SetTooltip("%s", tip);
+        Layer::get().set_description(tip);
+    }
+    return pressed;
+}
+
+// The same setting as Settings > System > Language, saved at once.
+void choose_language(const char *code) {
+    settings::Settings &s = settings::current();
+    if (s.language == code) return;
+    s.language = code;
+    settings::save();
+    host_text::set_language(code);
+}
+
+// The home page until a button is chosen; `focus` is the button focused
+// first. False: the window was closed.
+bool run_home_page(const install::HomeInfo &, Action focus, Action &chosen) {
+    Layer &layer = Layer::get();
+    const GameProfile &profile = portablekit::game();
+    bool first = true;
+    chosen = Action::None;
+    // FU Controls: the sidebar and Play sit far apart, so ImGui's own
+    // directional nav and tabbing do not link them. Right from the sidebar
+    // goes to Play, Left from Play back to the sidebar button focused last,
+    // and Tab runs down the sidebar and on to Play. `pending` is the button to
+    // focus when it is next drawn.
+    Action last_sidebar = Action::None;
+    Action pending = Action::None;
+    // FU Controls: the language flag to focus when next drawn: 0 none, 1 the
+    // English flag, 2 the Brazilian one. The flags sit below and left of Play,
+    // where ImGui's own directional nav and tabbing do not reach them.
+    int pending_flag = 0;
+    return layer.run(
+        [&] {
+            // Back does nothing here: a stray press of the pad's back button
+            // must not close the program. Quit is a button of its own.
+            (void)layer.take_back();
+            // Leave the drop queued for the mod page to validate and review.
+            if(profile.launcher_mods_page && layer.has_dropped_file()) chosen=Action::Mods;
+            else (void)layer.take_dropped_file();
+            if (profile.launcher_background) profile.launcher_background();
+            const ImVec2 display = ImGui::GetIO().DisplaySize;
+            const float sidebar = std::min(display.x * 0.32f, font() * 14.0f);
+            const float padding = font() * 1.4f;
+            auto *background = ImGui::GetBackgroundDrawList();
+            background->AddRectFilled({0, 0}, {sidebar, display.y}, IM_COL32(12, 19, 26, 245));
+            background->AddLine({sidebar, 0}, {sidebar, display.y}, colors::kPanelEdge);
+            const bool wide = display.x > sidebar + font() * 22.0f;
+            const bool branded = display.x > sidebar + font() * 12.0f && profile.launcher_logo &&
+                profile.launcher_logo(sidebar + padding, padding * 0.25f,
+                    display.x - sidebar - 2 * padding, display.y * (wide ? 0.32f : 0.27f));
+            // Ports without a logo retain the readable text title.
+            if (wide && !branded) {
+                const float x = sidebar + font() * 2.5f;
+                const float y = display.y * 0.12f;
+                background->AddRectFilled({x - font(), y - font()},
+                    {display.x - padding, y + font() * 7.0f}, IM_COL32(10, 20, 29, 120), px(12));
+                ImGui::SetNextWindowPos({x, y});
+                ImGui::SetNextWindowSize({display.x - x - padding, font() * 7.0f});
+                ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, {0, 0});
+                ImGui::Begin("##home_title", nullptr, ImGuiWindowFlags_NoDecoration |
+                    ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoSavedSettings |
+                    ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoMove);
+                paragraph(host_text::cstr("launcher.home.welcome_back"), colors::kAccentBright);
+                ImGui::PushFont(nullptr, font() * 2.6f);
+                paragraph(profile.project_name);
+                ImGui::PopFont();
+                ImGui::PushFont(nullptr, font() * 0.8f);
+                paragraph(profile.game_title, colors::kTextDim);
+                ImGui::PopFont();
+                ImGui::End();
+                ImGui::PopStyleVar();
+            }
+            ImGui::SetNextWindowPos({0, 0});
+            ImGui::SetNextWindowSize(display);
+            ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, {padding, padding});
+            ImGui::Begin("##home", nullptr, ImGuiWindowFlags_NoDecoration |
+                ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoSavedSettings |
+                ImGuiWindowFlags_NoMove);
+            const unsigned count=5u+unsigned(profile.launcher_mods_page!=nullptr)+unsigned(profile.launcher_cheats_page!=nullptr)+
+                unsigned(profile.launcher_whats_new_page!=nullptr)+unsigned(profile.launcher_report_page!=nullptr);
+            const float nav_top=padding*.65f;
+            const float nav_height=std::max(1.0f,display.y-font()*5.5f-nav_top);
+            const float step=nav_height/count;
+            const float button_height=std::max(10.0f,std::min(font()*2.2f,step-font()*.28f));
+            ImGui::SetCursorScreenPos({padding,nav_top});
+            ImGui::BeginChild("navigation", {sidebar - padding * 2,nav_height}, ImGuiChildFlags_NavFlattened,
+                ImGuiWindowFlags_NoScrollbar|ImGuiWindowFlags_NoScrollWithMouse);
+            const auto nav_at=ImGui::GetCursorScreenPos();
+            const float width = ImGui::GetContentRegionAvail().x - px(4);
+            std::vector<Action> order;
+            Action focused = Action::None;
+            const auto button = [&](Action action, const char *label, bool primary, const char *description) {
+                if ((first && action == focus) || action == pending) focus_next_row();
+                ImGui::SetCursorScreenPos({nav_at.x,nav_at.y+order.size()*step});
+                ImGui::PushFont(nullptr,std::min(font(),button_height*.56f));
+                if (big_button(label, width, primary,false,button_height,true)) chosen = action;
+                ImGui::PopFont();
+                if (ImGui::IsItemFocused()) focused = last_sidebar = action;
+                order.push_back(action);
+                if (ImGui::IsItemFocused() || ImGui::IsItemHovered()) layer.set_description(description);
+                if (ImGui::IsItemHovered()) ImGui::SetTooltip("%s",description);
+            };
+            button(Action::Settings, host_text::cstr("launcher.home.settings"), false, host_text::cstr("launcher.home.video_audio_and_controls"));
+            if (profile.launcher_mods_page)
+                button(Action::Mods, host_text::cstr("launcher.home.mods"), false, host_text::cstr("launcher.home.manage_optional_content"));
+            if (profile.launcher_cheats_page)
+                button(Action::Cheats, host_text::cstr("launcher.home.cheats"), false, host_text::cstr("launcher.home.health_stamina_and_damage_controls"));
+            button(Action::Saves, host_text::cstr("launcher.home.saves"), false, host_text::cstr("launcher.home.manage_and_back_up_your"));
+            button(Action::GameData, host_text::cstr("launcher.home.game_data"), false, host_text::cstr("launcher.home.manage_the_installed_game_data"));
+            button(Action::Screenshots, host_text::cstr("launcher.home.screenshots"), false, host_text::cstr("launcher.home.open_the_folder_f12_saves"));
+            if (profile.launcher_whats_new_page)
+                button(Action::WhatsNew, host_text::cstr("launcher.home.whats_new"), false, host_text::cstr("launcher.home.what_changed_in_this_version"));
+            if (profile.launcher_report_page)
+                button(Action::Report, host_text::cstr("launcher.home.report_a_bug"), false,
+                       host_text::cstr("launcher.home.zip_your_logs_settings_and"));
+            button(Action::Quit, host_text::cstr("launcher.home.quit"), false, host_text::cstr("launcher.home.close_the_launcher"));
+            ImGui::EndChild();
+            if (pending != Action::Play) pending = Action::None;
+            if (focused != Action::None) {
+                const bool tab = ImGui::IsKeyPressed(ImGuiKey_Tab, true);
+                const bool shift = ImGui::GetIO().KeyShift;
+                const auto at = std::find(order.begin(), order.end(), focused) - order.begin();
+                if (right_pressed()) pending = Action::Play;
+                else if (tab && !shift) pending = at + 1 < static_cast<std::ptrdiff_t>(order.size()) ? order[at + 1] : Action::Play;
+                else if (tab && shift) pending = at > 0 ? order[at - 1] : Action::Play;
+            }
+            const float hero_x = sidebar + padding * 0.5f;
+            const float hero_width = display.x - hero_x - padding * 0.5f;
+            const float play_width = std::min(font() * 6.5f, hero_width * 0.24f);
+            const float row_y = display.y*.37f;
+            const float row_height = std::max(0.0f,display.y-row_y-font()*.9f);
+            if (profile.launcher_save_preview)
+                profile.launcher_save_preview(hero_x,row_y,hero_width,row_height,first);
+            if (profile.launcher_start_requested && profile.launcher_start_requested()) chosen = Action::Play;
+            ImGui::SetCursorScreenPos({hero_x,row_y-font()*2.65f});
+            if ((first && focus == Action::Play) || pending == Action::Play) focus_next_row();
+            if (pending == Action::Play) pending = Action::None;
+            if (big_button(host_text::cstr("launcher.home.play"), play_width - px(4), true,false,0,true)) chosen = Action::Play;
+            if (ImGui::IsItemFocused() && !order.empty()) {
+                const bool tab = ImGui::IsKeyPressed(ImGuiKey_Tab, true);
+                const bool shift = ImGui::GetIO().KeyShift;
+                if (left_pressed()) pending = last_sidebar != Action::None ? last_sidebar : order.front();
+                else if (tab && shift) pending = order.back();
+                // Tab and Down go on to the language flags; Tab from the last
+                // flag wraps to the top of the sidebar.
+                else if (tab || down_pressed()) pending_flag = 1;
+            }
+            if (ImGui::IsItemFocused() || ImGui::IsItemHovered()) layer.set_description(host_text::cstr("launcher.home.start_your_adventure"));
+            if (profile.launcher_update_button) {
+                ImGui::SetCursorScreenPos({padding,display.y-padding*.5f-font()*4.3f});
+                if (profile.launcher_update_button(sidebar - padding * 2)) chosen = Action::Quit;
+                // The update button is the last item it submits; when it can
+                // take focus (Update, retry), Down goes on to the flags.
+                if (ImGui::IsItemFocused() && down_pressed()) pending_flag = 1;
+            }
+            {
+                // FU Controls: language flags, highlighting the language that
+                // resolved (on Auto: an enabled translation mod's, else the system's).
+                ImGui::Dummy({0, font() * 0.3f});
+                const std::string shown = host_text::effective_language();
+                const int flag_to_focus = pending_flag;
+                pending_flag = 0;
+                // Each flag: Up goes back to Play, Left and Right between the two,
+                // Tab on (the last one wraps to the sidebar), Shift+Tab back.
+                // Enter or the pad's confirm button activates the focused one.
+                const auto flag_nav = [&](int index) {
+                    if (!ImGui::IsItemFocused()) return;
+                    const bool tab = ImGui::IsKeyPressed(ImGuiKey_Tab, true);
+                    const bool shift = ImGui::GetIO().KeyShift;
+                    if (up_pressed()) pending = Action::Play;
+                    else if (index == 1 && right_pressed()) pending_flag = 2;
+                    else if (index == 2 && left_pressed()) pending_flag = 1;
+                    else if (tab && !shift) {
+                        if (index == 1) pending_flag = 2;
+                        else if (!order.empty()) pending = order.front();
+                    } else if (tab && shift) {
+                        if (index == 2) pending_flag = 1;
+                        else pending = Action::Play;
+                    }
+                };
+                // Not on the frame a flag takes the focus: the key that moved it
+                // there is still down and would move it on at once.
+                if (flag_button("##lang_en", false, shown == "en", host_text::cstr("launcher.lang.en"), flag_to_focus == 1))
+                    choose_language("en");
+                if (flag_to_focus == 0) flag_nav(1);
+                ImGui::SameLine(0.0f, px(10.0f));
+                if (flag_button("##lang_pt_br", true, shown == "pt-BR", host_text::cstr("launcher.lang.pt_br"), flag_to_focus == 2))
+                    choose_language("pt-BR");
+                if (flag_to_focus == 0) flag_nav(2);
+            }
+            ImGui::End();
+            ImGui::PopStyleVar();
+            // Drawn last so it sits over the hero art; it never takes focus first.
+            if (profile.launcher_banner) profile.launcher_banner(hero_x, padding, hero_width);
+            first = false;
+            return chosen == Action::None;
+        },
+        false);
+}
+
+// The in-game menu's save rows and screens, before the game boots. Import
+// there checks a save's files and backs up the current save first (item 11).
+// False: the window was closed.
+bool run_saves_page(const install::HomeInfo &info) {
+    Layer &layer = Layer::get();
+    bool done = false;
+    bool first = true;
+    bool was_editing = false;
+    return layer.run(
+        [&] {
+            const bool back = layer.take_back() || pad_back_pressed();
+            // Back closes an open import, export or backup screen first.
+            const bool screen_was_open = save_screen_open();
+            begin_panel("##home_saves", host_text::cstr("launcher.home.saves"), portablekit::game().project_name, false);
+            begin_content();
+            if (!save_screen(back)) {
+                section(host_text::cstr("launcher.home.saves"));
+                save_rows(true, first);
+                first = false;
+                ImGui::Dummy({0.0f, px(8.0f)});
+                if (button_row(host_text::cstr("launcher.home.back"), {false, {}, host_text::cstr("launcher.home.back_to_the_home_screen")})) done = true;
+                ImGui::Dummy({0.0f, px(8.0f)});
+                ImGui::Indent(px(16.0f));
+                detail(host_text::cstr("launcher.home.saves_folder"), saves_text(info));
+                ImGui::Unindent(px(16.0f));
+            }
+            begin_footer();
+            hints({{Control::Confirm, host_text::cstr("launcher.home.select")}, {Control::Back, host_text::cstr("launcher.home.back")}});
+            end_panel();
+            if (!screen_was_open && back && !was_editing) done = true;
+            was_editing = ImGui::IsAnyItemActive();
+            return !done;
+        },
+        false);
+}
+
+// The data folder and the disc image, and the way into the setup. False: the
+// window was closed.
+bool run_game_data_page(const install::HomeInfo &info, bool &set_up) {
+    Layer &layer = Layer::get();
+    bool done = false;
+    bool first = true;
+    set_up = false;
+    return layer.run(
+        [&] {
+            if (layer.take_back() || pad_back_pressed()) done = true;
+            begin_panel("##home_data", host_text::cstr("launcher.home.game_data"), portablekit::game().project_name, false);
+            begin_content();
+            ImGui::Dummy({0.0f, font() * 0.3f});
+            ImGui::Indent(px(16.0f));
+            details(info);
+            ImGui::Unindent(px(16.0f));
+            ImGui::Dummy({0.0f, font() * 0.3f});
+            if (first) focus_next_row();
+            first = false;
+            if (button_row(host_text::cstr("launcher.home.set_up_game_data_again"),
+                           {false, {},
+                            host_text::cstr("launcher.home.choose_the_disc_image_again")})) {
+                set_up = true;
+                done = true;
+            }
+#if !defined(PORTABLEKIT_ANDROID_APP)
+            if (button_row(host_text::cstr("launcher.home.open_the_data_folder"), {false, {}, host_text::cstr("launcher.home.show_the_data_folder_in")}))
+                (void)open_folder(info.game_dir);
+#endif
+            if (button_row(host_text::cstr("launcher.home.back"), {false, {}, host_text::cstr("launcher.home.back_to_the_home_screen")})) done = true;
+            begin_footer();
+            hints({{Control::Confirm, host_text::cstr("launcher.home.select")}, {Control::Back, host_text::cstr("launcher.home.back")}});
+            end_panel();
+            return !done;
+        },
+        false);
+}
+
+// FU Saves, item 11: before Play, when the mods that change saves are not the
+// ones the save was last used with (GameProfile::save_mods_changed).
+enum class ModsChoice { Cancel, Play, Quit };
+
+std::string join(const std::vector<std::string> &names) {
+    std::string out;
+    for (const std::string &name : names) out += (out.empty() ? "" : host_text::get("launcher.mods_warning.separator")) + name;
+    return out;
+}
+
+ModsChoice run_mods_warning_page(const install::HomeInfo &info, const std::vector<std::string> &added,
+                                 const std::vector<std::string> &removed) {
+    namespace ab = savedata::auto_backup;
+    Layer &layer = Layer::get();
+    bool done = false;
+    bool first = true;
+    ModsChoice choice = ModsChoice::Cancel;
+    std::string error;
+    const bool open = layer.run(
+        [&] {
+            if (layer.take_back() || pad_back_pressed()) done = true;
+            begin_panel("##home_mods_warning", host_text::get("launcher.mods_warning.title"),
+                        portablekit::game().project_name, false);
+            begin_content();
+            ImGui::Indent(px(16.0f));
+            paragraph(host_text::get("launcher.mods_warning.text"));
+            if (!added.empty())
+                paragraph(host_text::format("launcher.mods_warning.added", {join(added)}), colors::kTextDim);
+            if (!removed.empty())
+                paragraph(host_text::format("launcher.mods_warning.removed", {join(removed)}), colors::kTextDim);
+            if (!error.empty())
+                paragraph(host_text::format("launcher.mods_warning.backup_failed", {error}), colors::kDanger);
+            ImGui::Unindent(px(16.0f));
+            ImGui::Dummy({0.0f, px(8.0f)});
+            if (first) focus_next_row();
+            first = false;
+            if (button_row(host_text::get("launcher.mods_warning.backup_and_play").c_str(),
+                           {false, {}, host_text::get("launcher.mods_warning.backup_and_play_help")},
+                           colors::kAccentBright)) {
+                const char *summary = portablekit::game().save_summary_file;
+                const std::size_t keep = std::max<std::size_t>(portablekit::game().auto_backup_keep, 1);
+                // Same check as the pre-game backup: skipped when the save matches the
+                // newest backup, so an unchanged save never rotates out an older one.
+                const ab::Result backup = ab::back_up_if_changed(
+                    ab::make_config(info.memory_stick, portablekit::game().save_game_name,
+                                    summary != nullptr ? summary : "", keep),
+                    std::chrono::system_clock::now());
+                std::cout << "[saves] backup before play with changed mods: "
+                          << (backup.ok ? (backup.skipped ? std::string("skipped (no save, or same as the newest backup)") : install::path_to_utf8(backup.folder))
+                                        : backup.error)
+                          << std::endl;
+                if (backup.ok) {
+                    choice = ModsChoice::Play;
+                    done = true;
+                } else {
+                    error = backup.error;
+                }
+            }
+            if (button_row(host_text::get("launcher.mods_warning.play").c_str(),
+                           {false, {}, host_text::get("launcher.mods_warning.play_help")})) {
+                choice = ModsChoice::Play;
+                done = true;
+            }
+            if (button_row(host_text::get("launcher.mods_warning.cancel").c_str(),
+                           {false, {}, host_text::get("launcher.mods_warning.cancel_help")}))
+                done = true;
+            begin_footer();
+            const std::string select = host_text::get("dialog.hint.select"), back = host_text::get("dialog.hint.back");
+            hints({{Control::Confirm, select.c_str()}, {Control::Back, back.c_str()}});
+            end_panel();
+            return !done;
+        },
+        false);
+    return open ? choice : ModsChoice::Quit;
+}
+
+install::HomeChoice leave_home(install::HomeChoice choice) {
+    Layer::get().set_interactive(false);
+    return choice;
+}
+
+} // namespace
+
+install::HomeChoice show_home(const install::HomeInfo &info) {
+    if (ensure_renderer() == nullptr || !Layer::get().attached()) return install::HomeChoice::Play;
+    // The save screen works on the memory stick the game is about to use; the
+    // game sets the same one again when it boots.
+    if (!info.memory_stick.empty()) savedata::set_memory_stick(info.memory_stick);
+    Layer::get().set_interactive(true);
+    // FU Controls: the language setting picks which host.txt applies.
+    host_text::set_language(settings::current().language);
+    Action focus = Action::Play;
+    // FU Controls: the release notes, once after an update.
+    if (game().launcher_whats_new_due != nullptr && game().launcher_whats_new_page != nullptr &&
+        game().launcher_whats_new_due() && !game().launcher_whats_new_page())
+        return leave_home(install::HomeChoice::Quit);
+    for (;;) {
+        Action chosen = Action::None;
+        if (!run_home_page(info, focus, chosen)) return leave_home(install::HomeChoice::Quit);
+        if (chosen != Action::None) focus = chosen;
+        switch (chosen) {
+        case Action::Play: {
+            std::vector<std::string> added, removed;
+            if (game().save_mods_changed != nullptr && !info.memory_stick.empty() &&
+                game().save_mods_changed(info.memory_stick, added, removed)) {
+                const ModsChoice mods = run_mods_warning_page(info, added, removed);
+                if (mods == ModsChoice::Quit) return leave_home(install::HomeChoice::Quit);
+                if (mods == ModsChoice::Cancel) break;
+            }
+            return leave_home(install::HomeChoice::Play);
+        }
+        case Action::Quit: return leave_home(install::HomeChoice::Quit);
+        case Action::Settings:
+            if (!run_settings_before_boot()) return leave_home(install::HomeChoice::Quit);
+            break;
+        case Action::Mods:
+            if (game().launcher_mods_page != nullptr && !game().launcher_mods_page())
+                return leave_home(install::HomeChoice::Quit);
+            break;
+        case Action::Cheats:
+            if (game().launcher_cheats_page != nullptr && !game().launcher_cheats_page())
+                return leave_home(install::HomeChoice::Quit);
+            break;
+        case Action::Saves:
+            if (!run_saves_page(info)) return leave_home(install::HomeChoice::Quit);
+            break;
+        case Action::Screenshots: {
+            const std::filesystem::path folder = gpu::screenshot_folder();
+            if (!folder.empty()) (void)open_folder(folder);
+            break;
+        }
+        case Action::WhatsNew:
+            if (game().launcher_whats_new_page != nullptr && !game().launcher_whats_new_page())
+                return leave_home(install::HomeChoice::Quit);
+            break;
+        case Action::Report:
+            if (game().launcher_report_page != nullptr && !game().launcher_report_page())
+                return leave_home(install::HomeChoice::Quit);
+            break;
+        case Action::GameData: {
+            bool set_up = false;
+            if (!run_game_data_page(info, set_up)) return leave_home(install::HomeChoice::Quit);
+            if (set_up) return leave_home(install::HomeChoice::SetUp);
+            break;
+        }
+        case Action::None: break;
+        }
+    }
+}
+
