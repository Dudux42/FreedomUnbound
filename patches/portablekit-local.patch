@@ -0,0 +1,88 @@
+#include "save_data/launcher_import.hpp"
+
+#include "save_data/param_sfo.hpp"
+
+#include <fstream>
+#include <iterator>
+#include <optional>
+#include <system_error>
+#include <vector>
+
+namespace portablekit::savedata::launcher_import {
+namespace {
+
+namespace fs = std::filesystem;
+
+bool is_file(const fs::path &p) {
+    std::error_code ec;
+    return fs::is_regular_file(p, ec);
+}
+
+// The save folder in what was picked: itself, or <picked>/<name>,
+// <picked>/SAVEDATA/<name>, <picked>/PSP/SAVEDATA/<name>.
+fs::path locate(const fs::path &picked, const std::string &save_name) {
+    if (is_file(picked / "PARAM.SFO")) return picked;
+    for (const fs::path &candidate :
+         {picked / save_name, picked / "SAVEDATA" / save_name, picked / "PSP" / "SAVEDATA" / save_name})
+        if (is_file(candidate / "PARAM.SFO")) return candidate;
+    return {};
+}
+
+} // namespace
+
+Check check_folder(const fs::path &picked, const std::string &save_name, const std::string &data_file) {
+    Check check;
+    check.folder = locate(picked, save_name);
+    if (check.folder.empty()) {
+        check.folder = picked;
+        check.problem = "saves.import_pre.problem.no_save";
+        return check;
+    }
+    std::error_code ec;
+    const auto size = fs::file_size(check.folder / "PARAM.SFO", ec);
+    if (ec || size == 0 || size > 64 * 1024) {
+        check.problem = "saves.import_pre.problem.bad_sfo";
+        return check;
+    }
+    std::ifstream in(check.folder / "PARAM.SFO", std::ios::binary);
+    const std::vector<std::uint8_t> bytes{std::istreambuf_iterator<char>(in), {}};
+    const std::optional<ParamSfo> sfo = ParamSfo::parse(bytes);
+    if (!sfo) {
+        check.problem = "saves.import_pre.problem.bad_sfo";
+        return check;
+    }
+    const std::optional<std::string> directory = sfo->string("SAVEDATA_DIRECTORY");
+    if (!directory || *directory != save_name) {
+        check.problem = "saves.import_pre.problem.other_save";
+        return check;
+    }
+    if (!data_file.empty()) {
+        const auto data_size = fs::file_size(check.folder / data_file, ec);
+        if (ec || data_size == 0) {
+            check.problem = "saves.import_pre.problem.no_data";
+            return check;
+        }
+    }
+    return check;
+}
+
+Result import_with_backup(const auto_backup::Config &config, const Check &check,
+                          std::chrono::system_clock::time_point now, const Importer &importer) {
+    Result result;
+    if (!check.ok()) {
+        result.error = check.problem;
+        return result;
+    }
+    result.backup = auto_backup::back_up_if_changed(config, now);
+    if (!result.backup.ok) {
+        result.error = result.backup.error;
+        return result;
+    }
+    const Imported imported = importer(check.folder);
+    result.ok = imported.ok;
+    result.error = imported.error;
+    result.replaced = imported.replaced;
+    return result;
+}
+
+} // namespace portablekit::savedata::launcher_import
diff --git a/host/save_data/launcher_import.hpp b/host/save_data/launcher_import.hpp
new file mode 100644
index 0000000..ab70a20
--- /dev/null
+++ b/host/save_data/launcher_import.hpp
@@ -0,0 +1,55 @@
+#pragma once
+
+// Importing a PSP save from the launcher, before the game starts (FU Saves,
+// item 11). The in-game Import checks a save with the game's own key, which
+// the launcher does not have, so here a folder is checked for the expected
+// files only: a PARAM.SFO that parses and names the game's main save folder,
+// and the save's data file, present and not empty. The save's contents are
+// never read, decrypted or logged.
+//
+// Before anything is copied, the current save gets an automatic backup
+// (auto_backup.hpp). The copy itself is the in-game Import's import_save()
+// (save_transfer.hpp), passed in as `Importer`: it copies beside the save
+// first, moves the replaced save to PSP/SAVEDATA/.backup/<time>/, then moves
+// the copy into place. Keeping it a parameter lets tests run without a profile.
+#include "save_data/auto_backup.hpp"
+
+#include <chrono>
+#include <filesystem>
+#include <functional>
+#include <string>
+
+namespace portablekit::savedata::launcher_import {
+
+// Why a folder cannot be imported, as a host_text id (saves.import_pre.problem.*).
+struct Check {
+    std::filesystem::path folder;  // the save folder itself
+    std::string problem;           // empty: can be imported
+    [[nodiscard]] bool ok() const { return problem.empty(); }
+};
+
+// `picked` is the save folder (<SAVEDATA>/ULUS10391), or a SAVEDATA folder,
+// or a memory stick root, holding it.
+[[nodiscard]] Check check_folder(const std::filesystem::path &picked, const std::string &save_name,
+                                 const std::string &data_file);
+
+struct Imported {
+    bool ok{};
+    std::string error;
+    std::filesystem::path replaced;  // where the replaced save went (.backup); empty when none
+};
+using Importer = std::function<Imported(const std::filesystem::path &folder)>;
+
+struct Result {
+    bool ok{};
+    std::string error;
+    auto_backup::Result backup;      // the automatic backup made first (skipped when unchanged)
+    std::filesystem::path replaced;  // as Imported::replaced
+};
+
+// Backs up the current save if it changed since the newest backup, then
+// imports. A failed backup stops the import.
+Result import_with_backup(const auto_backup::Config &config, const Check &check,
+                          std::chrono::system_clock::time_point now, const Importer &importer);
+
+} // namespace portablekit::savedata::launcher_import
