@@ -0,0 +1,24 @@
+#pragma once
+#include "ge_state.hpp"
+#include <cmath>
+#include <optional>
+
+namespace portablekit::gpu {
+inline std::optional<std::array<float, 2>> project_overlay_point(
+    const std::array<float, 3> &world, const std::array<float, 16> &view,
+    const std::array<float, 16> &projection, const ViewportState &vp) {
+    auto transform = [](const auto &m, const std::array<float, 4> &p) {
+        std::array<float, 4> out{};
+        for (unsigned row = 0; row < 4; ++row)
+            for (unsigned col = 0; col < 4; ++col) out[row] += m[col * 4 + row] * p[col];
+        return out;
+    };
+    const auto clip = transform(projection, transform(view, {world[0], world[1], world[2], 1.0f}));
+    for (float v : clip) if (!std::isfinite(v)) return {};
+    if (clip[3] <= 0.0001f || std::abs(clip[2]) > clip[3]) return {};
+    const float x = vp.x_offset - vp.offset_x + vp.x_scale * clip[0] / clip[3];
+    const float y = vp.y_offset - vp.offset_y + vp.y_scale * clip[1] / clip[3];
+    if (!std::isfinite(x) || !std::isfinite(y) || x < 0 || x > 480 || y < 0 || y > 272) return {};
+    return std::array<float, 2>{x / 480.0f, y / 272.0f};
+}
+}
