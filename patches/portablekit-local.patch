+void run_import_pre() {
+    State &s = state();
+    const auto now = std::chrono::system_clock::now();
+    // The in-game Import's copy (import_save): beside the save first, the
+    // replaced save moved to PSP/SAVEDATA/.backup/<time>/, then swapped in.
+    const fs::path backup_dir = sd::backup_directory(savedata_root(), now);
+    const li::Importer importer = [&](const fs::path &folder) {
+        sd::SaveCheck check;
+        check.folder = folder;
+        check.name = portablekit::game().save_game_name;
+        const sd::ImportResult imported = sd::import_save(check, sd::memory_stick(), backup_dir);
+        return li::Imported{imported.ok, imported.error, imported.backup};
+    };
+    s.pre_result = li::import_with_backup(backup_config(), s.pre_check, now, importer);
+    std::cout << "[saves] launcher import from " << utf8(s.pre_check.folder) << ": "
+              << (s.pre_result.ok ? "done" : s.pre_result.error)
+              << (s.pre_result.backup.skipped ? "" : "; backed up to " + utf8(s.pre_result.backup.folder))
+              << std::endl;
+    go(Stage::ImportedPre);
+}
