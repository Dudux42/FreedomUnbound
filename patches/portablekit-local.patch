+void AudioSink::set_output_suppressed(bool suppressed) {
+    Impl &impl = *impl_;
+    {
+        std::lock_guard<std::mutex> guard(impl.lock);
+        if (impl.output_suppressed.load() == suppressed) return;
+        // The device callback holds this same lock while filling its stream.
+        // Retain timeline/cursors but discard the buffered hidden-screen mix.
+        if (!suppressed) std::fill(impl.ring.begin(), impl.ring.end(), 0);
+        impl.output_suppressed.store(suppressed);
+    }
+    const float gain = suppressed ? 0.0f : impl.gain;
+#if defined(PORTABLEKIT_HAS_SDL_AUDIO)
+    // SDL may acquire its stream lock; never call it while holding impl.lock.
+    if (impl.stream != nullptr) SDL_SetAudioStreamGain(impl.stream, gain);
+#endif
+    std::cout << "Audio: temporary suppression " << suppressed << "; output gain " << gain << "\n";
+}
