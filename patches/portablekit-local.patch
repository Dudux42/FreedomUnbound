+struct Table {
+    std::mutex mu;
+    std::unordered_map<std::string, std::string> english;
+    std::unordered_map<std::string, std::string> current;
+    Provider provider;
+    std::vector<std::pair<std::filesystem::path, std::filesystem::file_time_type>> sources;
+    std::chrono::steady_clock::time_point next_check{};
+    bool loaded{};
+};
+
+Table &table() {
+    static Table value;
+    return value;
+}
+
+void ensure_english(Table &t) {
+    if (!t.english.empty()) return;
+    for (const Entry &e : kDefaults) t.english.emplace(e.id, e.english);
+    t.current = t.english;
+}
+
+std::string unescape(std::string_view text) {
+    std::string out;
+    out.reserve(text.size());
+    for (std::size_t i = 0; i < text.size(); ++i) {
+        if (text[i] == '\\' && i + 1 < text.size()) {
+            const char next = text[i + 1];
+            if (next == 'n') { out += '\n'; ++i; continue; }
+            if (next == '\\') { out += '\\'; ++i; continue; }
+        }
+        out += text[i];
+    }
+    return out;
+}
+
+std::string_view trim(std::string_view s) {
+    while (!s.empty() && (s.front() == ' ' || s.front() == '\t')) s.remove_prefix(1);
+    while (!s.empty() && (s.back() == ' ' || s.back() == '\t' || s.back() == '\r')) s.remove_suffix(1);
+    return s;
+}
+
+void apply_file(Table &t, const std::filesystem::path &file) {
+    std::ifstream in(file, std::ios::binary);
+    if (!in) return;
+    std::string line;
+    int number = 0;
+    int applied = 0;
+    while (std::getline(in, line)) {
+        ++number;
+        std::string_view view = line;
+        if (number == 1 && view.substr(0, 3) == "\xEF\xBB\xBF") view.remove_prefix(3);
+        if (!view.empty() && view.back() == '\r') view.remove_suffix(1);
+        const std::string_view head = trim(view);
+        if (head.empty() || head.front() == '#') continue;
+        const auto eq = view.find('=');
+        if (eq == std::string_view::npos) {
+            std::cerr << "[host_text] " << file.string() << ":" << number << ": no '=', line ignored\n";
+            continue;
+        }
+        const std::string id{trim(view.substr(0, eq))};
+        if (!t.english.contains(id)) {
+            std::cerr << "[host_text] " << file.string() << ":" << number << ": unknown id '" << id << "' ignored\n";
+            continue;
+        }
+        // Text is kept as written after '=', so leading spaces can be meant;
+        // a value wrapped in double quotes is the text between them (value_text).
+        t.current[id] = unescape(value_text(view.substr(eq + 1)));
+        ++applied;
+    }
+    std::cerr << "[host_text] " << applied << " strings from " << file.string() << "\n";
+}
+
+decltype(Table::sources) stat_sources(const std::vector<std::filesystem::path> &files) {
+    decltype(Table::sources) out;
+    for (const auto &f : files) {
+        std::error_code ec;
+        auto stamp = std::filesystem::last_write_time(f, ec);
+        if (ec) stamp = {};
+        out.emplace_back(f, stamp);
+    }
+    return out;
+}
+
+void rebuild(Table &t, decltype(Table::sources) sources) {
+    ensure_english(t);
+    t.current = t.english;
+    for (const auto &[file, stamp] : sources)
+        if (stamp != std::filesystem::file_time_type{}) apply_file(t, file);
+    t.sources = std::move(sources);
+    t.loaded = true;
+}
+
+// Holds t.mu.
+void refresh(Table &t, bool force) {
+    ensure_english(t);
+    if (!t.provider) return;
+    const auto now = std::chrono::steady_clock::now();
+    if (!force && t.loaded && now < t.next_check) return;
+    t.next_check = now + std::chrono::seconds(1);
+    std::vector<std::filesystem::path> files;
+    try {
+        files = t.provider();
+    } catch (const std::exception &e) {
+        std::cerr << "[host_text] could not list text mods: " << e.what() << "\n";
+        return;
+    }
+    auto sources = stat_sources(files);
+    if (!force && t.loaded && sources == t.sources) return;
+    rebuild(t, std::move(sources));
+}
+
+} // namespace
+
+const std::vector<Entry> &defaults() { return kDefaults; }
+
+std::string get(std::string_view id) {
+    Table &t = table();
+    std::lock_guard lock(t.mu);
+    refresh(t, false);
+    const auto it = t.current.find(std::string(id));
+    if (it != t.current.end()) return it->second;
+    return std::string(id);
+}
+
+std::string format(std::string_view id, std::initializer_list<std::string> args) {
+    std::string text = get(id);
+    std::size_t index = 0;
+    for (const std::string &arg : args) {
+        const std::string mark = "{" + std::to_string(index++) + "}";
+        for (std::size_t at = text.find(mark); at != std::string::npos; at = text.find(mark, at + arg.size()))
+            text.replace(at, mark.size(), arg);
+    }
+    return text;
+}
+
+const char *cstr(std::string_view id) {
+    std::string text = get(id);
+    static std::mutex mu;
+    static std::unordered_set<std::string> pool;  // node-based: a kept string never moves
+    std::lock_guard lock(mu);
+    return pool.insert(std::move(text)).first->c_str();
+}
+
+namespace {
+std::mutex &language_mutex() {
+    static std::mutex mu;
+    return mu;
+}
+std::string &language_value() {
+    static std::string value = "auto";
+    return value;
+}
+} // namespace
+
+void set_language(std::string_view setting) {
+    {
+        std::lock_guard lock(language_mutex());
+        if (language_value() == setting) return;
+        language_value() = std::string(setting);
+    }
+    std::cerr << "[host_text] language setting: " << setting << "\n";
+    reload();
+}
+
+std::string language_setting() {
+    std::lock_guard lock(language_mutex());
+    return language_value();
+}
+
+namespace {
+std::string &effective_value() {
+    static std::string value;
+    return value;
+}
+} // namespace
+
+void set_effective_language(std::string_view language) {
+    std::lock_guard lock(language_mutex());
+    effective_value() = std::string(language);
+}
+
+std::string effective_language() {
+    {
+        std::lock_guard lock(language_mutex());
+        if (!effective_value().empty()) return effective_value();
+        if (language_value() != "auto") return language_value();
+    }
+    return system_language();
+}
+
+std::string system_language() {
+#if defined(_WIN32)
+    wchar_t name[LOCALE_NAME_MAX_LENGTH] = {};
+    if (LCIDToLocaleName(MAKELCID(GetUserDefaultUILanguage(), SORT_DEFAULT), name, LOCALE_NAME_MAX_LENGTH, 0) <= 0 &&
+        GetUserDefaultLocaleName(name, LOCALE_NAME_MAX_LENGTH) <= 0)
+        return "en";
+    return std::towlower(name[0]) == L'p' && std::towlower(name[1]) == L't' ? "pt-BR" : "en";
+#else
+    for (const char *variable : {"LC_ALL", "LC_MESSAGES", "LANG"}) {
+        const char *value = std::getenv(variable);
+        if (value == nullptr || *value == '\0') continue;
+        return (value[0] == 'p' || value[0] == 'P') && (value[1] == 't' || value[1] == 'T') ? "pt-BR" : "en";
+    }
+    return "en";
+#endif
+}
+
+void set_provider(Provider provider) {
+    Table &t = table();
+    std::lock_guard lock(t.mu);
+    t.provider = std::move(provider);
+    t.loaded = false;
+}
+
+void reload() {
+    Table &t = table();
+    std::lock_guard lock(t.mu);
+    refresh(t, true);
+}
+
+} // namespace portablekit::ui::host_text
