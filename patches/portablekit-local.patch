+            close = true;
+            result = "back";
+        } else {
+            close = true;
+            result = std::nullopt;
+        }
+    }
+
+    std::string title = d.request.title.empty() ? host_text::get("dialog.title.message") : d.request.title;
+    if (d.phase == Phase::Confirm)
+        title = host_text::get(d.kind == DialogKind::DeleteList ? "dialog.title.delete" : "dialog.title.save");
+    const std::string subtitle = subtitle_of(d);
+    const bool arm = std::exchange(d.arm_focus, false);
+
+    begin_panel("##psp-dialog", title, subtitle, true);
+    begin_content();
+    if (d.phase == Phase::Confirm) {
+        paragraph(host_text::get(d.kind == DialogKind::DeleteList ? "save.confirm.delete" : "save.confirm.overwrite"));
+        if (!d.pending_label.empty()) paragraph(d.pending_label, colors::kTextDim);
+        const bool yes = button_row(button("dialog.button.yes", "##psp").c_str());
+        if (arm) focus_next_row();
+        const bool no = button_row(button("dialog.button.no", "##psp").c_str());
+        if (!close && !to_list) {
+            if (yes) {
+                close = true;
+                result = d.pending_id;
+            } else if (no) to_list = true;
+        }
+    } else if (d.kind == DialogKind::Notice) {
+        if (!d.request.message.empty()) paragraph(d.request.message);
+        if (arm) focus_next_row();
+        const bool ok = button_row(button("dialog.button.ok", "##notice").c_str());
+        if (!close && ok) {
+            close = true;
+            result = "ok";
+        }
+    } else if (d.kind == DialogKind::YesNo) {
+        if (!d.request.message.empty()) paragraph(d.request.message);
+        if (arm && !d.request.default_no) focus_next_row();
+        const bool yes = button_row(button("dialog.button.yes", "##yn").c_str());
+        if (arm && d.request.default_no) focus_next_row();
+        const bool no = button_row(button("dialog.button.no", "##yn").c_str());
+        if (!close) {
+            if (yes) {
+                close = true;
+                result = "yes";
+            } else if (no) {
+                close = true;
+                result = "no";
+            }
+        }
+    } else if (d.request.choices.empty()) {
+        if (d.request.message.empty()) paragraph(host_text::get("save.no_data"));
+        else paragraph(d.request.message);
+        if (arm) focus_next_row();
+        const bool back_row = button_row(button("dialog.button.back", "##empty").c_str());
+        if (!close && back_row) {
+            close = true;
+            result = std::nullopt;
+        }
+    } else {
+        if (!d.request.message.empty()) paragraph(d.request.message);
+        for (int i = 0; i < static_cast<int>(d.request.choices.size()); ++i) {
+            const DialogChoice &choice = d.request.choices[static_cast<std::size_t>(i)];
+            if (arm && i == d.request.initial) focus_next_row();
+            const std::string row_id = "##slot" + std::to_string(i);
+            const bool pressed = list_row(row_id.c_str(), choice.label, choice.detail,
+                                          choice.occupied ? ListIcon::File : ListIcon::None, false);
+            if (close || to_confirm || !pressed) continue;
+            if (d.kind == DialogKind::LoadList) {
+                if (choice.occupied) {
+                    close = true;
+                    result = choice.id;
+                }
+            } else if (d.kind == DialogKind::SaveList) {
+                if (choice.occupied) {
+                    to_confirm = true;
+                    confirm_id = choice.id;
+                    confirm_label = choice.label;
+                } else {
+                    close = true;
+                    result = choice.id;
+                }
+            } else if (choice.occupied) {
+                to_confirm = true;
+                confirm_id = choice.id;
+                confirm_label = choice.label;
+            }
+        }
+    }
+    layer.set_description(footer_text(d));
+    begin_footer();
+    if (d.kind == DialogKind::Notice) {
+        const std::string ok = host_text::get("dialog.hint.ok");
+        hints({{Control::Confirm, ok.c_str()}, {Control::Back, ok.c_str()}});
+    } else if (d.kind == DialogKind::YesNo || d.phase == Phase::Confirm) {
+        const std::string choose = host_text::get("dialog.hint.choose"), back_hint = host_text::get("dialog.hint.back");
+        hints({{Control::Confirm, choose.c_str()}, {Control::Back, back_hint.c_str()}});
+    } else {
+        const std::string select = host_text::get("dialog.hint.select"), cancel = host_text::get("dialog.hint.cancel");
+        hints({{Control::Confirm, select.c_str()}, {Control::Back, cancel.c_str()}});
+    }
+    end_panel();
+
+    if (!d.open) return;
+    if (to_list && !close) {
+        d.phase = Phase::Main;
+        d.arm_focus = true;
+    } else if (to_confirm && !close) {
+        d.phase = Phase::Confirm;
+        d.pending_id = std::move(confirm_id);
+        d.pending_label = std::move(confirm_label);
+        d.arm_focus = true;
+    } else if (close) finish(std::move(result));
+}
+
+} // namespace portablekit::ui
diff --git a/host/ui/system_dialogs.hpp b/host/ui/system_dialogs.hpp
new file mode 100644
index 0000000..83a66f7
--- /dev/null
+++ b/host/ui/system_dialogs.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+// Message and save-list dialogs for sceUtility, drawn with the same panels
+// as the rest of the interface and over the running game. The game keeps
+// polling; a dialog stays until the player answers.
+namespace portablekit::ui {
+
+struct DialogChoice {
+    std::string id;
+    std::string label;
+    std::string detail;
+    bool occupied{};
+};
+
+enum class DialogKind { Notice, YesNo, LoadList, SaveList, DeleteList };
+
+struct DialogRequest {
+    std::string title;
+    std::string message;
+    bool default_no{};
+    std::vector<DialogChoice> choices;
+    int initial{};
+};
+
+// Notice answers "ok". Yes/No answers "yes", "no" or "back".
+// A list answers the choice id, or nullopt when the player cancels.
+using DialogDone = std::function<void(std::optional<std::string>)>;
+
+[[nodiscard]] bool system_dialog_open();
+// False when there is no window to draw in. Does not call on_done.
+bool open_system_dialog(DialogKind kind, DialogRequest request, DialogDone on_done);
+// Closes without calling on_done and gives input back to the game.
+void dismiss_system_dialog();
+void system_dialog_frame();
+
+} // namespace portablekit::ui
