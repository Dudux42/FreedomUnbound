+void VulkanRenderer::Impl::prepare_texture_scene(const GuestMemory &memory) {
+    if (!pack || !portablekit::game().texture_scene || texture_scene_frame == frames) return;
+    texture_scene_frame = frames;
+    static const bool disabled = portablekit::env_set("DISABLE_TEXTURE_WARMUP");
+    if (disabled) return;
+    const auto scene = portablekit::game().texture_scene(memory);
+    if (texture_scene_id == scene) return;
+    texture_scene_id = scene;
+    const auto images = pack->enter_scene(scene);
+    if (images.empty()) return;
+    const auto start = std::chrono::steady_clock::now();
+    const auto deadline = start + std::chrono::milliseconds(500);
+    std::size_t uploaded = 0, prepared = 0;
+    constexpr std::size_t limit = 64u * 1024u * 1024u;
+    // Drain each request before issuing the next: speculative images must not
+    // fill the bounded decode queue and starve actual on-screen requests.
+    for (const auto &image : images) {
+        if (std::chrono::steady_clock::now() >= deadline || uploaded >= limit) break;
+        pack->request(*image, true);
+        if (!pack->wait_decoded(*image, deadline)) {
+            warmup_pending.push_back(image);
+            break;
+        }
+        const auto state = image->state.load(std::memory_order_acquire);
+        const auto bytes = state == Replacement::State::Decoded ? image->pixels.size() : 0u;
+        if (bytes > limit - uploaded) {
+            pack->discard_decoded(*image);
+            break;
+        }
+        if (replacements.descriptor(*image, *pack, frames, true)) {
+            uploaded += bytes;
+            ++prepared;
+        }
+    }
+    std::cout << "[texpack-warmup] scene=" << scene << " prepared=" << prepared << '/' << images.size()
+              << " upload-MiB=" << (uploaded >> 20u) << " elapsed-ms="
+              << std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now()-start).count()
+              << '\n';
+}
